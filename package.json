{
  "name": "app-agent-adapter",
  "version": "0.0.0",
  "description": "A local-app-first AI agent adapter built on the Vercel AI SDK.",
  "keywords": [
    "agent",
    "ai",
    "ai-sdk",
    "electrobun",
    "electron"
  ],
  "homepage": "https://github.com/halby24/app-agent-adapter#readme",
  "bugs": {
    "url": "https://github.com/halby24/app-agent-adapter/issues"
  },
  "license": "MIT",
  "author": "HALBY",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/halby24/app-agent-adapter.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build",
    "prepare": "vp config"
  },
  "dependencies": {
    "ai": "^7.0.142"
  },
  "devDependencies": {
    "@ai-sdk/harness": "^1.0.153",
    "@types/node": "^26.6.5",
    "bumpp": "^12.3.0",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@ai-sdk/harness": "^1.0.153"
  },
  "peerDependenciesMeta": {
    "@ai-sdk/harness": {
      "optional": true
    }
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.14.0",
      "onFail": "download"
    }
  }
}
